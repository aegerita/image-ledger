{
  "name": "obsidian-image-ledger",
  "version": "0.1.0",
  "description": "Capture, describe, and deduplicate self-contained JPEG and PNG images in Obsidian.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "test:vault": "npm run build && node --import tsx scripts/test-vault.ts",
    "install:vault": "node scripts/install.mjs",
    "test:obsidian": "node --import tsx scripts/obsidian-smoke.ts"
  },
  "dependencies": {
    "@lezer/markdown": "^1.8.1",
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "exifr": "7.1.3",
    "obsidian": "1.14.4",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
