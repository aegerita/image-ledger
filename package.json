{
  "name": "obsidian-journal-media",
  "version": "0.1.0",
  "description": "Preserve pasted journal images locally with UUID filenames, captions and linked Bases records.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "install:vault": "node scripts/install.mjs"
  },
  "dependencies": {
    "exifr": "7.1.3"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
